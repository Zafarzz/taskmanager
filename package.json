{
  "name": "planjet",
  "private": true,
  "version": "1.0.0",
  "description": "PlanJet Telegram Task Manager monorepo (NestJS backend + React Vite frontend)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:backend": "npm --workspace=backend run start:dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm --workspace=frontend run build",
    "build:backend": "npm --workspace=backend run build",
    "lint:frontend": "npm --workspace=frontend run lint",
    "lint:backend": "npm --workspace=backend run lint",
    "prisma:generate": "npm --workspace=backend exec -- prisma generate",
    "prisma:migrate": "npm --workspace=backend exec -- prisma migrate deploy",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
